{
  "schema": 3,
  "nodeId": "monitorgerador-fuxa-poc",
  "admin": {"bind": "127.0.0.1:18080"},
  "security": {
    "requireAllowlist": true,
    "commandPlaneEnabled": false
  },
  "limits": {"maxActivePairs": 16},
  "tunnels": [
    {
      "id": "gen153-field-15002-to-fuxa",
      "pairTimeoutSeconds": 30,
      "writeTimeoutSeconds": 30,
      "drainTimeoutSeconds": 2,
      "field": {
        "mode": "listen",
        "network": "tcp",
        "bind": "0.0.0.0:15002",
        "allowedCidrs": ["192.0.2.10/32"],
        "keepAliveSeconds": 30
      },
      "consumer": {
        "mode": "listen",
        "network": "tcp",
        "bind": "127.0.0.1:25002",
        "keepAliveSeconds": 30
      }
    }
  ]
}
